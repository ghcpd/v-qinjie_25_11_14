# Environment variables for SECURE version
# Copy this to .env.secure and update values

# Flask Configuration
FLASK_DEBUG=False
ENVIRONMENT=production
HOST=127.0.0.1
PORT=5001

# Secrets (use strong, random values in production)
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
API_KEY=sk_live_secure_production_key_12345
STRIPE_KEY=sk_test_stripe_secure_key
DATABASE_PASSWORD=secure_db_password_hash
SERVICE_ACCOUNT_KEY=secure_service_account_key

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
